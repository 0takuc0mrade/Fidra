# Arc Testnet public RPC. Foundry loads this value for the `arc_testnet` RPC alias.
ARC_RPC_URL=https://rpc.testnet.arc.network

# Fidra protocol accounting uses only this 6-decimal ERC-20 USDC interface.
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# 100 basis points = a 1% discount. Valid range: 1-3000.
ADVANCE_DISCOUNT_BPS=100

# The live deployment is intentionally not frozen yet.
FREEZE_AUTHORIZED_VAULT=false

# Current Arc Testnet deployment. Do not redeploy or replace these without a reviewed migration.
MANDATE_MANAGER_ADDRESS=0xEfA2b3e70138810eA51552177c3f1AE5ab249EF2
ADVANCE_VAULT_ADDRESS=0x5F7Bec9eC341F816182a56D8E033cac63DBd8C8B

# The read-only checker asserts both contract owners against this address.
EXPECTED_OWNER=0xeC68c705001a158d0f810182Ca205887679E33f5

# Manual liquidity/smoke defaults, denominated in 6-decimal ERC-20 USDC units.
# 5 USDC of vault liquidity and a 1 USDC smoke claim keep the first live flow tiny.
DEMO_LIQUIDITY_AMOUNT=5000000
SMOKE_ACTOR_ADDRESS=0xeC68c705001a158d0f810182Ca205887679E33f5
SMOKE_FACE_AMOUNT=1000000
SMOKE_RUN_ID=2

# Runtime-only fallback. Never put a real key in this file or commit a private key.
# Prefer `cast wallet import <name> --interactive` and Forge's `--account` option.
# PRIVATE_KEY=

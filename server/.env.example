# Circle User-Controlled Wallets. Disabled and fail-closed by default.
CIRCLE_WALLETS_ENABLED=false
CIRCLE_MOCK_MODE=false
CIRCLE_ENV=sandbox
CIRCLE_API_KEY=
CIRCLE_APP_ID=
CIRCLE_GOOGLE_CLIENT_ID=

# Durable hosted runtime. Required when NODE_ENV=production. Keep this value
# server-side; Neon connection strings must never use a VITE_ prefix.
DATABASE_URL=
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# Not required by the selected user-controlled social/email flow. Reserved for
# future Circle products only; never expose or commit secret values.
CIRCLE_WALLET_SET_ID=
CIRCLE_ENTITY_SECRET=

# Arc Testnet and live Fidra V1.1 deployment.
ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_BLOCK_EXPLORER_URL=https://testnet.arcscan.app
USDC_ADDRESS=0x3600000000000000000000000000000000000000
V1_PLATFORM_REGISTRY_ADDRESS=0x20EcB05d90D4F24F8Fcf2785BdE240796B8b1af3
V1_EARNINGS_MANAGER_ADDRESS=0xdC1C359fC174Fb8C7cDcbE0e09447d123dD9cD57
V1_ADVANCE_VAULT_ADDRESS=0x12604e5acD074D3499C9ac4D2cbb4Bd39ECE49c5
V1_DEPLOYMENT_BLOCK=55168614

# Legacy V0 evidence routes only.
MANDATE_MANAGER_ADDRESS=0xEfA2b3e70138810eA51552177c3f1AE5ab249EF2
ADVANCE_VAULT_ADDRESS=0x5F7Bec9eC341F816182a56D8E033cac63DBd8C8B

# Testnet-only Arc native USDC gas seed. Use a dedicated key that is neither the
# protocol owner nor the sandbox platform signer. The private key is runtime-only.
WORKER_GAS_SEED_ENABLED=false
OPERATOR_SEED_PRIVATE_KEY=
MAX_WORKER_GAS_SEED_USDC=0.05
WORKER_GAS_SEED_USDC=0.04
SEED_ONCE_PER_WALLET=true
WORKER_GAS_DAILY_BUDGET_USDC=2
WORKER_GAS_WALLET_RESERVE_USDC=0.2

# V1.4 public demo. Disabled and fail-closed until a fresh platform (>2) is
# registered to this dedicated testnet-only signer. Never use the owner key.
SANDBOX_WRITES_ENABLED=false
SANDBOX_PLATFORM_ID=
SANDBOX_PLATFORM_PRIVATE_KEY=
PROTOCOL_OWNER_ADDRESS=0xeC68c705001a158d0f810182Ca205887679E33f5
SANDBOX_CLAIM_FACE_VALUE_UNITS=100000
SANDBOX_MAX_CLAIM_FACE_VALUE_UNITS=100000
SANDBOX_CLAIM_DUE_SECONDS=604800
SANDBOX_MAX_CREDIT_LIMIT_UNITS=1000000
SANDBOX_MIN_RESERVE_UNITS=100000
SANDBOX_GLOBAL_BUDGET_USDC=10
SANDBOX_REQUESTS_PER_MINUTE=12

# Local/unit-test JSON adapters only. Hosted mode uses DATABASE_URL and never
# silently falls back to these files.
FIDRA_RUNTIME_DATA_DIR=
WORKER_WALLET_METADATA_FILE=
DEMO_WORKFLOW_FILE=

# Server/session configuration.
HOST=0.0.0.0
PORT=8787
SESSION_TTL_SECONDS=86400
SERVER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax
ARC_VERIFICATION_TIMEOUT_SECONDS=120
